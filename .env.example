# Copy to .env and fill in. Vite only reads these at startup, so restart the
# dev server after changing anything here, and rebuild for a deployed site —
# VITE_ variables are baked into the bundle at build time.

# Where the end-of-simulation feedback goes: a Google Apps Script Web App that
# writes into a Sheet. Full setup, including the script itself, is in
# docs/feedback.md. Leave this unset and the question simply is not asked —
# the form never renders rather than throwing answers away.
VITE_FEEDBACK_URL=
