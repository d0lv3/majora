# Copy this file to .env and fill it in. .env is gitignored — never commit it.

PORT=4000
NODE_ENV=development

# A local mongod, or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/majora

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; development falls back to a throwaway with a warning.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the Vite app runs. Comma-separate to allow more than one.
CORS_ORIGIN=http://localhost:5173
